    "middle_name": "document.name|middleNames|upper",
    "residence_address_line1": "document.address|withoutCareOf|addressLine1|upper",
    "residence_address_line2": "document.address|withoutCareOf|addressLine2|upper",
    "residence_country": "document.country|upper",
    "pincode": "document.pincode",
    "dob": "document.dob",
    "tax_residence_country": "copy.residence_country",
    "tax_reference_type": "default.PAN",
    "tax_reference_number": "document.pan",
    "title": "typed",
    "email": "typed",
    "mobile": "typed",
    "fax": "typed",
    "place": "typed",
    "form_date": "today",
    "subscription_amount": "typed",
    "initial_sales_charge": "default.Nil",
    "series": "tick",
    "bank_name": "typed",
    "bank_address": "typed",
    "swift_code": "typed",
    "account_name": "copy.subscriber_name",
